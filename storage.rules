rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /deal-images/{merchantUid}/{fileName} {
      // Anyone signed into the app can view deal photos.
      allow read: if request.auth != null;

      // Only the merchant themself can upload into their own folder,
      // and only actual images under 5MB.
      allow write: if request.auth != null
                   && request.auth.uid == merchantUid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == merchantUid;
    }
  }
}
